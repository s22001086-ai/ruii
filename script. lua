RunService.RenderStepped:Connect(function(dt)
    for _, dotData in ipairs(activeDots) do
        dotData.YPos = dotData.YPos + (dotData.Speed * dt)
        if dotData.YPos > 450 then
            dotData.YPos = -10
            dotData.XBase = rng:NextInteger(0, 580)
        end
        local driftOffset = math.sin(tick() + dotData.XBase) * 5
        dotData.Frame.Position = UDim2.new(0, dotData.XBase + driftOffset, 0, dotData.YPos)
    end
end)

