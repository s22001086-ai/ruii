        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not _G.ZoomRateEnabled then return end
    if _G.ZoomOnlyWhenCamlocked and not Camlock.Active then return end

    local currentMin = Player.CameraMinZoomDistance
    local currentMax = Player.CameraMaxZoomDistance
    local currentTarget = math.clamp(targetZoom, _G.ZoomMin, _G.ZoomMax)

    local newZoomMin = currentMin + (currentTarget - currentMin) * math.clamp(dt * _G.ZoomSpeed, 0, 1)
    local newZoomMax = currentMax + (currentTarget - currentMax) * math.clamp(dt * _G.ZoomSpeed, 0, 1)

    Player.CameraMinZoomDistance = newZoomMin
    Player.CameraMaxZoomDistance = newZoomMax
end)

