local function createPillToggle(parent, nameText, posY, initialState, callback)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, -10, 0, 36)
    toggleBtn.Position = UDim2.new(0, 5, 0, posY)
    toggleBtn.BackgroundColor3 = initialState and cardBase or white
    toggleBtn.BorderSizePixel = 1
    toggleBtn.BorderColor3 = lightBlue
    toggleBtn.Text = "  " .. nameText .. ": " .. (initialState and "ON" or "OFF")
    toggleBtn.TextColor3 = textBlue
    toggleBtn.Font = customFont
    toggleBtn.TextSize = 15
    toggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    toggleBtn.AutoButtonColor = false
    toggleBtn.ZIndex = 5
    toggleBtn.Parent = parent
    applyTextGlow(toggleBtn, lightBlue)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 18)
    corner.Parent = toggleBtn
    local pillTrack = Instance.new("Frame")
    pillTrack.Size = UDim2.new(0, 38, 0, 20)
    pillTrack.Position = UDim2.new(1, -44, 0.5, -10)
    pillTrack.BackgroundColor3 = initialState and lightPink or lightBlue
    pillTrack.BorderSizePixel = 0
    pillTrack.ZIndex = 6
    pillTrack.Parent = toggleBtn
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = pillTrack
    local pillKnob = Instance.new("Frame")
    pillKnob.Size = UDim2.new(0, 16, 0, 16)
    pillKnob.Position = UDim2.new(initialState and 1 or 0, initialState and -18 or 2, 0.5, -8)
    pillKnob.BackgroundColor3 = white
    pillKnob.BorderSizePixel = 0
    pillKnob.ZIndex = 7
    pillKnob.Parent = pillTrack
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = pillKnob

    toggleBtn.MouseButton1Click:Connect(function()
        initialState = not initialState
        local twInfo = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        if initialState then
            toggleBtn.Text = "  " .. nameText .. ": ON"
            TweenService:Create(toggleBtn, twInfo, {BackgroundColor3 = cardBase}):Play()
            TweenService:Create(pillTrack, twInfo, {BackgroundColor3 = lightPink}):Play()
            TweenService:Create(pillKnob, twInfo, {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            toggleBtn.Text = "  " .. nameText .. ": OFF"
            TweenService:Create(toggleBtn, twInfo, {BackgroundColor3 = white}):Play()
            TweenService:Create(pillTrack, twInfo, {BackgroundColor3 = lightBlue}):Play()
            TweenService:Create(pillKnob, twInfo, {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
        callback(initialState)
    end)
end

