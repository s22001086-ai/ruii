            else
                if targetZoom >= _G.ZoomMax then
                    targetZoom = _G.ZoomMin
                    local pauseTime = math.max(_G.ZoomStayMin / math.max(_G.ZoomFrequency, 0.1), 0.01)
                    task.wait(pauseTime)
                else
                    targetZoom = _G.ZoomMax
                    local pauseTime = math.max(_G.ZoomStayMax / math.max(_G.ZoomFrequency, 0.1), 0.01)
                    task.wait(pauseTime)
                end
            end
