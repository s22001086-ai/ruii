local guiOpen = true
local function toggleGui()
    if guiOpen then
        TweenService:Create(cardContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        task.wait(0.25)
        cardContainer.Visible = false
        cardContainer.Size = UDim2.new(0, 580, 0, 450)
        cardContainer.Position = UDim2.new(0.5, -290, 0.5, -225)
        toggleBtn.Text = "☰"
        guiOpen = false
    else
        cardContainer.Visible = true
        cardContainer.Size = UDim2.new(0, 0, 0, 0)
        cardContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
        TweenService:Create(cardContainer, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 580, 0, 450),
            Position = UDim2.new(0.5, -290, 0.5, -225)
        }):Play()
        toggleBtn.Text = "✕"
        guiOpen = true
    end
end

toggleBtn.MouseButton1Click:Connect(toggleGui)

-- Перетаскивание кнопки пальцем
local draggingBtn = false
local dragStart = nil
local startPos = nil

toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        draggingBtn = true
        dragStart = input.Position
        startPos = toggleBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingBtn = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingBtn and input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
